{
    "name": "notideus/notideus-php",
    "description": "Official PHP SDK for the Notideus email API",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["notideus", "email", "email api", "transactional email", "marketing email", "sdk", "php", "api client", "whatsapp"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Notideus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Notideus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
